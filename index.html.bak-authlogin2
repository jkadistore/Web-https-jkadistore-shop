<script>/* LOGO RESMI JK ADISTORE — dipasang di semua tempat (Rev 5) */
(function(){
  var LOGO_URL='images/logo-owner.webp';
  var CERT_LOGO='assets/img/logo.png?v=logo2026';
  function jkLogo(){
    var l=document.getElementById('logoImg'); if(l&&l.src!==LOGO_URL) l.src=LOGO_URL;
    var a=document.getElementById('avatarImg'); if(a&&a.src!==LOGO_URL) a.src=LOGO_URL;
    var o=document.getElementById('ownerPhoto'); if(o&&o.src!==LOGO_URL) o.src=LOGO_URL;
    var cl=document.getElementById('certLogo'); if(cl) cl.src=CERT_LOGO;
    var cv=document.querySelector('.cert-verify-logo'); if(cv) cv.src=CERT_LOGO;
  }
  /* override STORE default agar app.js memakai logo resmi */
  try{
    var raw=localStorage.getItem('jka_db_v3');
    if(raw){ var db=JSON.parse(raw); if(db&&db.store){ db.store.logo=LOGO_URL; db.store.avatar=LOGO_URL; db.store.ownerPhoto=LOGO_URL; localStorage.setItem('jka_db_v3',JSON.stringify(db)); } }
  }catch(e){}
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',jkLogo); else jkLogo();
  window.addEventListener('load',jkLogo);
  /* guard: pertahankan logo resmi jika app.js re-render */
  var n=0; var t=setInterval(function(){ jkLogo(); if(++n>=20) clearInterval(t); },800);
})();
</script>
