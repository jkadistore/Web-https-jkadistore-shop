<script>/* 🔒🔓 TUTUP/BUKA WEBSITE — nama website otomatis tercantum/hilang (kontrol Panel Owner) */
(function(){
  function jkApplySiteStatus(st){
    try{
      var ai=document.getElementById('jkNavAi'), fo=document.getElementById('jkNavFoto');
      if(ai) ai.style.display=(st&&st.ai)?'none':'';
      if(fo) fo.style.display=(st&&st.foto)?'none':'';
    }catch(e){}
  }
  function jkCache(st){ try{ localStorage.setItem('jk_site_closed',JSON.stringify({ai:!!(st&&st.ai),foto:!!(st&&st.foto)})); }catch(e){} }
  try{ jkApplySiteStatus(JSON.parse(localStorage.getItem('jk_site_closed')||'{}')); }catch(e){}
  function jkLoadSiteStatus(){
    fetch('/api/site-status',{credentials:'same-origin'})
      .then(function(r){ return r.ok?r.json():null; })
      .then(function(j){ if(j&&j.success){ jkCache(j); jkApplySiteStatus(j); } })
      .catch(function(){});
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',jkLoadSiteStatus); else jkLoadSiteStatus();
  window.addEventListener('storage',function(ev){
    if(ev&&ev.key==='jk_site_closed'){ try{ jkApplySiteStatus(JSON.parse(ev.newValue||'{}')); }catch(e){} }
  });
  window.jkRefreshSiteStatus=jkLoadSiteStatus;
  var n=0,t=setInterval(function(){ jkLoadSiteStatus(); if(++n>=4) clearInterval(t); },1500);
})();
</script>
