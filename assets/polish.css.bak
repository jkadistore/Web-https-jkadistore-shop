/* ============================================================
   JK ADISTORE — Polish Layout & Category Grid
   HP: 3 kolom / Desktop: 4 kolom, kotak kategori seragam,
   ikon logo WebP HD (tanpa emoji teks).
   Identitas, warna, dan struktur asli JK ADISTORE tetap.
   ============================================================ */

/* ---------- FONT IKON (untuk karakter non-emoji seperti X, bintang rating) ---------- */
.ic-x, .ic-chev, .ic-arrow { font-family: system-ui, Arial, sans-serif; }

/* ---------- GRID PRODUK: HP 3 KOLOM, DESKTOP 4 KOLOM ---------- */
.p-grid {
  display: grid !important;
  grid-template-columns: repeat(4, 1fr) !important;
  gap: 13px;
}
@media (max-width: 1024px) {
  .p-grid { grid-template-columns: repeat(4, 1fr) !important; gap: 11px; }
}
@media (max-width: 860px) {
  .p-grid { grid-template-columns: repeat(3, 1fr) !important; gap: 10px; }
}
@media (max-width: 640px) {
  .p-grid { grid-template-columns: repeat(3, 1fr) !important; gap: 9px; }
}
@media (max-width: 360px) {
  .p-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 8px; }
}

/* Kartu produk pas & rapi, tidak kebesaran di HP */
.p-grid .card { min-width: 0; }
.p-grid .card h3 {
  font-size: 12.5px !important;
  min-height: 34px;
  line-height: 1.3;
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.p-grid .card .smart-desc { display: none; } /* hemat ruang di HP, tetap ada di detail */
@media (min-width: 861px) {
  .p-grid .card .smart-desc { display: -webkit-box; }
}
.p-grid .card .price { font-size: 14.5px !important; }
.p-grid .card .p-actions { gap: 5px; }
.p-grid .card .p-actions .btn { font-size: 11.5px; padding: 6px 4px; min-height: 32px; }

/* ---------- SECTION "KATEGORI PRODUK" (pengganti Pilih Game Dulu) ---------- */
.jk-cat-section { margin-top: 26px; }
.jk-cat-title {
  font-family: var(--font-title);
  font-size: clamp(20px, 3.4vw, 34px);
  font-weight: 900;
  letter-spacing: 1px;
  color: #fff;
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 4px;
}
.jk-cat-title img.jk-cat-title-ic {
  width: 44px; height: 44px;
  border-radius: 13px;
  box-shadow: 0 6px 22px rgba(0, 0, 0, .4);
  flex: 0 0 auto;
}
.jk-cat-sub { color: #aab2d5; font-size: 13px; font-weight: 600; margin-bottom: 16px; }

/* Grid kategori: HP 3 kolom, Desktop 4 kolom — ukuran sama, sejajar */
.jk-cat-grid {
  display: grid !important;
  grid-template-columns: repeat(4, 1fr);
  gap: 12px;
}
@media (max-width: 860px) { .jk-cat-grid { grid-template-columns: repeat(3, 1fr); gap: 9px; } }
@media (max-width: 400px) { .jk-cat-grid { grid-template-columns: repeat(2, 1fr); gap: 8px; } }

.jk-cat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 8px;
  padding: 14px 8px 12px;
  background: linear-gradient(180deg, rgba(255, 255, 255, .07), rgba(255, 255, 255, .03));
  border: 1px solid var(--stroke);
  border-radius: 18px;               /* sudut sedikit melengkung */
  cursor: pointer;
  transition: .22s ease;
  text-align: center;
  min-width: 0;
}
.jk-cat-card:hover {
  transform: translateY(-3px);
  border-color: color-mix(in srgb, var(--c3) 55%, transparent);
  background: linear-gradient(180deg, color-mix(in srgb, var(--c3) 12%, rgba(255,255,255,.06)), rgba(255,255,255,.04));
  box-shadow: 0 12px 34px rgba(0, 0, 0, .4);
}
.jk-cat-card.active {
  border-color: var(--c3);
  box-shadow: 0 0 0 1px var(--c3), 0 10px 30px color-mix(in srgb, var(--c3) 30%, transparent);
  background: color-mix(in srgb, var(--c3) 12%, rgba(255,255,255,.05));
}
.jk-cat-ic {
  width: 58px; height: 58px;
  object-fit: cover;
  border-radius: 15px;
  border: 1px solid rgba(255, 255, 255, .14);
  background: #0a0e26;
  box-shadow: 0 6px 18px rgba(0, 0, 0, .45);
  flex: 0 0 auto;
}
@media (max-width: 400px) { .jk-cat-ic { width: 50px; height: 50px; } }
.jk-cat-name {
  font-size: 11.5px;
  font-weight: 800;
  color: #e7ebff;
  line-height: 1.25;
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 29px;
}

/* ---------- IKON GAMBAR SERAGAM (menggantikan semua emoji) ---------- */
.jk-ic {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 22px; height: 22px;
  border-radius: 7px;
  object-fit: cover;
  flex: 0 0 auto;
  background: transparent;
  vertical-align: middle;
}
.jk-ic.lg { width: 30px; height: 30px; border-radius: 9px; }
.jk-ic.sm { width: 16px; height: 16px; border-radius: 5px; }
.jk-ic.tiny { width: 13px; height: 13px; border-radius: 4px; }
button .jk-ic, .btn .jk-ic { margin-right: 6px; }
.jk-ic + b, .jk-ic + span { vertical-align: middle; }

/* Ikon pada tombol header/nav (Produk, AI, Ulasan, Kontak) */
.nav-links .btn-sm .jk-ic { width: 18px; height: 18px; }
/* Ikon fitur "Layanan Premium" */
.feature-tile .ic { font-size: 0; line-height: 0; }
.feature-tile .ic img { width: 40px; height: 40px; border-radius: 12px; display: block; }
@media (max-width: 640px) { .feature-tile .ic img { width: 34px; height: 34px; } }
/* Ikon sosial & linkhub */
.social-bubble { font-size: 0; }
.social-bubble img { width: 26px; height: 26px; border-radius: 8px; display: block; }
.linkhub-ic { font-size: 0; }
.linkhub-ic img { width: 34px; height: 34px; border-radius: 10px; display: block; }
.linkhub-row-ic { width: 34px; text-align: center; font-size: 0; }
.linkhub-row-ic img { width: 28px; height: 28px; border-radius: 9px; display: block; }
.linkhub-row-go { font-size: 0; }
.linkhub-row-go img { width: 20px; height: 20px; display: block; }
/* Rating bintang jadi gambar */
.stars { font-size: 0; letter-spacing: normal; display: inline-flex; gap: 2px; }
.stars img { width: 15px; height: 15px; }
/* Search icon di input (sebelumnya emoji) */
.search-mini { position: relative; }
/* Modal head icon */
.mhead h2 img.jk-ic { margin-right: 4px; }
/* Hero action buttons */
.hero-actions .btn .jk-ic, #heroBtns .btn .jk-ic { width: 19px; height: 19px; }

/* ---------- BANNER SLIDER LEBIH RAPI ---------- */
.hero-slider { border-radius: 22px; }
.slide img { image-rendering: -webkit-optimize-contrast; }
.slide-caption {
  font-weight: 900;
  text-shadow: 0 3px 18px rgba(0, 0, 0, .55);
}
.slide-caption .jk-slide-eyebrow {
  display: inline-block;
  background: linear-gradient(120deg, var(--c1), var(--c2));
  color: #fff;
  font-size: clamp(10px, 1.6vw, 13px);
  letter-spacing: 2px;
  text-transform: uppercase;
  padding: 5px 12px;
  border-radius: 99px;
  margin-bottom: 8px;
}
.slide-caption .jk-slide-title {
  font-family: var(--font-title);
  font-size: clamp(18px, 4vw, 42px);
  line-height: 1.08;
  margin-bottom: 6px;
}
.slide-caption .jk-slide-sub {
  font-size: clamp(11px, 1.8vw, 15px);
  color: #cdd6ff;
  font-weight: 600;
  max-width: 520px;
}
@media (max-width: 700px) {
  .slide-caption .jk-slide-sub { display: none; }
  .slider-arrow { width: 34px; height: 34px; font-size: 0; }
  .slider-arrow img { width: 15px; height: 15px; display: block; }
}
.slider-arrow { font-size: 0; }
.slider-arrow img { width: 17px; height: 17px; display: block; }

/* ---------- CHIPS KATEGORI RAPI ---------- */
.chips { gap: 8px; }
.chip {
  white-space: nowrap;
  font-size: 12px;
  padding: 8px 14px;
  border-radius: 99px;
  min-height: 36px;
}
.chips::-webkit-scrollbar { height: 5px; }
.chips::-webkit-scrollbar-thumb { background: rgba(255,255,255,.18); border-radius: 9px; }

/* ---------- STAT & HERO KERAPIAN ---------- */
.stat-chip b { letter-spacing: .3px; }
.hero-stats { gap: 10px; }
@media (max-width: 640px) {
  .hero-stats { gap: 8px; }
  .stat-chip { padding: 8px 11px; border-radius: 14px; }
  .stat-chip b { font-size: 16px; }
  .stat-chip small { font-size: 8.8px; }
}

/* ---------- PRELOADER IKON ---------- */
.jk-preload { position: absolute; width: 1px; height: 1px; overflow: hidden; }

/* ---------- PRINT/KEJELASAN ---------- */
img { -webkit-user-drag: none; }
